ggtitle("Time Analysis European Call")
riskfree = 0.05
sigma = 0.2
time = 1
Periods = 80
lamda = seq(1, 2.1, 0.1)
lamda[3] = 1.22474
Probs = matrix(0,3,length(lamda))
dt = time/Periods
p1 = matrix((1 / (2*lamda^2)) + ((riskfree-0.5*sigma^2)*dt^0.5) / (2*lamda*sigma), nrow = length(lamda), ncol = 1)
p3 = matrix((1 / (2*lamda^2)) - ((riskfree-0.5*sigma^2)*dt^0.5) / (2*lamda*sigma), nrow = length(lamda), ncol = 1)
p2 = matrix(1 - (1 / lamda^2), nrow = length(lamda), ncol = 1)
# In order to ensure that p1,p2,p3 are possitive integers and sum to 1, we use the technic bellow.
# Absolute value is used to define the suitable values of lamda, the values that p1,p2,p3 are possitive..
#Probs = cbind(p1,p2,p3)
#AbsSum = apply(abs(Probs), 2, sum)
ProbabilityMatrix = data.frame(p1, p2, p3)
rownames(ProbabilityMatrix) = as.character(lamda)
colnames(ProbabilityMatrix) = c("Prob.1", "Prob.2", "Prob.3")
ggplot(ProbabilityMatrix)+
geom_line(mapping = aes(lamda, p1, color = 'Prob.1'))+
geom_line(mapping = aes(lamda, p2, color = 'Prob.2'))+
geom_line(mapping = aes(lamda, p3, color = 'Prob.3'))+
scale_color_manual(values = c('Prob.1' = 'cornflowerblue', 'Prob.2' = 'deeppink4', 'Prob.3' = 'darkolivegreen4')) +
labs(color = '')+
xlab("Lamda Values")+
ylab("Probabilities")+
theme_classic()+
theme(legend.position = "right")+
ggtitle("Probability Analysis")
