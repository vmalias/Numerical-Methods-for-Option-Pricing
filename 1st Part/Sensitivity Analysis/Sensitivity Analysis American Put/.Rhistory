ggplot(Mapping90)+
geom_line(mapping = aes(x = Periods, y = Lamda_1.1, col = "KR"))+
geom_line(mapping = aes(x = Periods, y = CRR, col = "CRR"))+
scale_color_manual(values = c('KR' = 'cornflowerblue', 'CRR' = 'deeppink4')) +
labs(color = '')+
xlab("Iterations")+
ylab("Distance from Black-Scholes")+
theme_classic()+
theme(legend.position = "top")+
ggtitle("Lamda = 1.1 (ITM)")
