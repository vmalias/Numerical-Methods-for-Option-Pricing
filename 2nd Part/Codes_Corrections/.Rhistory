BlackScholes_Value_EuCall = matrix(0, nrow=1, ncol=length(stock))
for (i in 1:length(stock)){
BlackScholes_Value_EuCall[i] = BlackScholesEuCall(stock[i],15,6/12,0.2,0.05)
Implicit_Value_EuCall[i] = BS_implicit_EuCall(stock[i],15,6/12,0.2,0.05,50,0.5,5/2400)
Implicit_Error_EuCall[i] = BlackScholes_Value_EuCall[i] - Implicit_Value_EuCall[i]
}
for (i in 1:length(stock)){
Explicit_Value_EuCall[i] = BS_explicit_EuCall(stock[i],15,6/12,0.2,0.05,50,0.5,5/2400)
Explicit_Error_EuCall[i] = BlackScholes_Value_EuCall[i] - Explicit_Value_EuCall[i]
}
ggplot()+
geom_line(mapping = aes(stock, Implicit_Value_EuCall, linetype = 'solid', color = 'Implicit'))+
geom_line(mapping = aes(stock, Explicit_Value_EuCall, linetype = 'dashed', color = 'Explicit'))+
geom_point(mapping = aes(stock, Explicit_Value_EuCall, color = 'Explicit'), shape = 1)+
scale_color_manual(values = c('Implicit' = 'deeppink4', 'Explicit' = 'seagreen3')) +
scale_linetype_manual(values = c('dashed', 'solid'), guide = "none")+
labs(title = 'European Call',
x = '',
y = '',
color = '')+
theme_classic()+
theme(legend.position = "top")
ggplot()+
geom_line(mapping = aes(stock, abs(Implicit_Error_EuCall), linetype = 'solid', color = 'Implicit'))+
geom_point(mapping = aes(stock, abs(Implicit_Error_EuCall), color = 'Implicit'), shape = 1)+
geom_line(mapping = aes(stock, abs(Explicit_Error_EuCall), linetype = 'dashed', color = 'Explicit'))+
geom_point(mapping = aes(stock, abs(Explicit_Error_EuCall), color = 'Explicit'), shape = 1)+
scale_color_manual(values = c('Implicit' = 'deeppink4', 'Explicit' = 'seagreen3')) +
scale_linetype_manual(values = c('dashed', 'dashed'), guide = "none")+
labs(title = 'European Call',
x = '',
y = '',
color = '')+
theme_classic()+
theme(legend.position = "top")
