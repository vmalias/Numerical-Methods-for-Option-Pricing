View(DKR)
PrecisionLevel = c(0.005, 0.01, 0.05)
MCScrr = matrix(0, length(StrikePrice), length(PrecisionLevel))
for (i in seq(1, length(PrecisionLevel))) {
for (j in seq(1, length(StrikePrice))) {
e = which(as.matrix(t(DCRR[j,])) < PrecisionLevel[i], arr.ind = T)
N = 1
while(sum(e[N:nrow(e),1]) != length(seq(e[N,2], e[nrow(e),2]))) {
N = N + 1
}
MCScrr[i,j] = as.integer(e[N,2])
}
}
colnames(MCScrr) = as.character(StrikePrice)
rownames(MCScrr) = as.character(PrecisionLevel)
View(MCScrr)
