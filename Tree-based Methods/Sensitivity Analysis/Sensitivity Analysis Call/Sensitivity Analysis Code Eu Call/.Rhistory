library(ggplot2)
library(openxlsx)
stock = seq(from=5, to=15, by=5)
dS = seq(2.5,0.5,0.5)
############################### European Call ##################################
Implicit_Value_EuCall = matrix(0, nrow=length(dS), ncol=length(stock))
rownames(Implicit_Value_EuCall) = as.character(dS)
colnames(Implicit_Value_EuCall) = as.character(stock)
Implicit_Error_EuCall = matrix(0, nrow=length(dS), ncol=length(stock))
rownames(Implicit_Error_EuCall) = as.character(dS)
colnames(Implicit_Error_EuCall) = as.character(stock)
Explicit_Value_EuCall = matrix(0, nrow=length(dS), ncol=length(stock))
rownames(Explicit_Value_EuCall) = as.character(dS)
colnames(Explicit_Value_EuCall) = as.character(stock)
Explicit_Error_EuCall = matrix(0, nrow=length(dS), ncol=length(stock))
rownames(Explicit_Error_EuCall) = as.character(dS)
colnames(Explicit_Error_EuCall) = as.character(stock)
BlackScholes_Value_EuCall = BlackScholesEuCall(stock,15,6/12,0.2,0.05)
for (i in 1:length(dS)) {
for (j in 1:length(stock)){
Implicit_Value_EuCall[i,j] = BS_implicit_EuCall(stock[j],15,6/12,0.2,0.05,50,dS[i],5/2400)
Implicit_Error_EuCall[i,j] = BlackScholes_Value_EuCall[j] - Implicit_Value_EuCall[i,j]
Explicit_Value_EuCall[i,j] = BS_explicit_EuCall(stock[j],15,6/12,0.2,0.05,50,dS[i],5/2400)
Explicit_Error_EuCall[i,j] = BlackScholes_Value_EuCall[j] - Explicit_Value_EuCall[i,j]
}
}
View(Explicit_Value_EuCall_dS)
View(Explicit_Error_EuCall_dS)
