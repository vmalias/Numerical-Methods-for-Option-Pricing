load("C:/Users/Vasilis/Downloads/RMSE.RData")
RMSE_Matrix = data.frame(RMSE_CRR, RMSE_KR)
colnames(RMSE_Matrix) = c("RMSE_CRR", "RMSE_KR")
rownames(RMSE_Matrix) = as.character(Periods)
#write.xlsx(RMSE_Matrix, "RMSE_Matrix.xlsx", colNames = TRUE, rowNames = TRUE)
ggplot(RMSE_Matrix)+
geom_line(mapping = aes(log(Periods), log(RMSE_CRR), color = 'RMSE_CRR'))+
geom_line(mapping = aes(log(Periods), log(RMSE_KR), color = 'RMSE_KR'))+
scale_color_manual(values = c('RMSE_CRR' = 'deeppink4', 'RMSE_KR' = 'cornflowerblue')) +
labs(color = '')+
xlab("log_Steps")+
ylab("log_RMSE")+
theme_classic()+
theme(legend.position = "right")+
ggtitle("Root Mean Squared Error")
